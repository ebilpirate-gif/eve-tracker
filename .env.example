# OPTIONAL. You normally don't need this file: open the app in a browser and the
# setup wizard asks for everything. Anything set here overrides the web UI.

# EVE application (from developers.eveonline.com)
# EVE_CLIENT_ID=
# EVE_CLIENT_SECRET=
# EVE_CALLBACK_URL=http://192.168.0.10:8000/callback

# Web UI password
# APP_PASSWORD=

# Contact info sent to CCP in the User-Agent (e.g. your in-game name)
# ESI_CONTACT=

# Where the SQLite database lives (default: ./data)
# DATA_DIR=/home/pi/eve-tracker/data
