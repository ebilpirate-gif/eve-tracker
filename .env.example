# Copy to .env and fill in. See README.md for how to register the EVE application.
EVE_CLIENT_ID=
EVE_CLIENT_SECRET=
# Must exactly match the callback URL registered at developers.eveonline.com
EVE_CALLBACK_URL=http://raspberrypi.local:8000/callback

# Password for the web UI (recommended: anyone on your network could otherwise see your wallets)
APP_PASSWORD=

# Optional: contact info sent to CCP in the User-Agent (e.g. your in-game name or email)
ESI_CONTACT=

# Where the SQLite database lives (default: ./data)
# DATA_DIR=/home/pi/eve-tracker/data
